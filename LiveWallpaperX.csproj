<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<AssemblyName>LiveWallpaperX</AssemblyName>
		<OutputType>WinExe</OutputType>
		<LangVersion>preview</LangVersion>
		<TargetFrameworks>net462</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
		<DebugType>none</DebugType>
		<WarningLevel>9999</WarningLevel>
		<IsPublishable>False</IsPublishable>
		<UseWPF>True</UseWPF>
		<AnalysisLevel>latest</AnalysisLevel>
		<GenerateSupportedRuntime>False</GenerateSupportedRuntime>
		<NoWarn></NoWarn>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<Optimize>True</Optimize>
		<Prefer32Bit>False</Prefer32Bit>
		<AllowUnsafeBlocks>False</AllowUnsafeBlocks>
		<ApplicationIcon>icon.ico</ApplicationIcon>
		<StripSymbols>True</StripSymbols>
		<DebugType>none</DebugType>
		<DebugSymbols>False</DebugSymbols>
		<EnableCOMHosting>False</EnableCOMHosting>
		<NoWin32Manifest>true</NoWin32Manifest>
		<OutputPath>.\bin\</OutputPath>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition="'$(PlatformTarget)' != ''">
		<AssemblyName>LiveWallpaperX_$(PlatformTarget)</AssemblyName>
		<OutputPath>.\bin\$(PlatformTarget)</OutputPath>
	</PropertyGroup>
	<ItemGroup>
		<None Remove=".gitignore" />
		<None Remove="demo.jpg" />
		<None Remove="icon.ico" />
		<None Remove="LICENSE" />
		<None Remove="logo.png" />
		<None Remove="README.md" />
		<None Remove="README.zh_CN.md" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="System.ServiceProcess" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="WindowsFormsIntegration" />
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Exec Command="lalaki_sign &quot;$(TargetPath)&quot;&gt;NUL 2&gt;&amp;1 &amp;" />
	</Target>
</Project>